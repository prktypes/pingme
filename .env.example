# Client-safe Supabase configuration.
# The anon key is public by design; never put the Google Places key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Set this as a Supabase Edge Function secret, never in the mobile app:
#   npx supabase secrets set GOOGLE_PLACES_API_KEY=...
GOOGLE_PLACES_API_KEY=YOUR_SERVER_SIDE_GOOGLE_PLACES_KEY
