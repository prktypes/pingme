{
  "expo": {
    "name": "Nearn",
    "slug": "nearn",
    "scheme": "nearn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prktypes.nearn",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.prktypes.nearn",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nearn uses your location to find nearby places and show what is around you.",
          "locationAlwaysPermission": "Nearn alerts you when you arrive at a place you saved for a reminder.",
          "locationAlwaysAndWhenInUsePermission": "Nearn alerts you when you arrive at a place you saved for a reminder. Your location history is never stored or uploaded.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5856D6",
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ]
  }
}
